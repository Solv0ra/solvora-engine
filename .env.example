# Ethereum RPC endpoint (Sepolia — the registry chain).
SEPOLIA_RPC_URL=https://sepolia.infura.io/v2/YOUR_PROJECT_ID

# Set your Alchemy key ONCE. The engine auto-builds the RPC URL for every supported chain
# (mainnet, Arbitrum, Optimism, Base, Polygon) from its built-in chain -> subdomain map.
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY

# Optional: JSON map of chainId -> RPC URL for custom / non-Alchemy providers.
# Takes precedence over ALCHEMY_API_KEY for the chains it lists.
# CHAIN_RPC_URLS={"1":"https://rpc.mevblocker.io"}
CHAIN_RPC_URLS=

ENTITY_REGISTRY_ADDRESS=0x80c740c5d1FB4ffCdb52449Bd10770C55Fb7CD41
ATTESTATION_ADDRESS=0xF0Eb7e96a49fe8305306A2F36bdE1094b97760c2
PORT=3000
DATABASE_URL=file:./dev.db
